####################### adding advisors

@add_advisors
title: Add advisors
choose-if: n_advisors < 3
unavailable-subtitle: Maximum of 3 advisors.
go-to: advisor_menu

@advisor_menu
title: Add other advisors.
tags: kanalarbeiter_advisor, classical_advisor, paleorev_advisor, neorev_advisor, sofo_advisor, nonfactional_advisor
frequency: 1


- @kanalarbeiter: Add Kanalarbeiter
- @classical: Add Classical Marxists
- @paleorev: Add Paleorevisionists
- @neorev: Add Neorevisionists
- @sofo: Add Social Progressives
- @nonfactional: Add non-factional advisors
- @rm_main: Remove advisors instead.
- @remove_none: Stop changing advisors.

@kanalarbeiter
subtitle: The glue holding the party together. Reduces faction loyalty decay by 30% for each advisor appointed.
view-if: n_advisors < 3

- #kanalarbeiter_advisor

@paleorev
view-if: n_advisors < 3

- #paleorev_advisor

@classical
view-if: n_advisors < 3

